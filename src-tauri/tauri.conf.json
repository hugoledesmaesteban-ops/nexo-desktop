{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo",
  "version": "0.1.0",
  "identifier": "com.nexo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexo",
        "width": 400,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421 http://localhost:8787 ws://localhost:8787 ws: wss:; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4M0JDQkVDNEVBNUZENDMKUldSRC9hVk83TXM3V014YjdraWpkcWMvNzdlb0grRG5HOG5wSTRIa09scTV1OGlidGJMVjRDZkQK",
      "endpoints": ["https://raw.githubusercontent.com/hugol/nexo-desktop/main/latest.json"]
    }
  }
}
